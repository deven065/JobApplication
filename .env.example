# Copy this file to .env (same folder) and fill in your values. .env is gitignored.

# --- AI (set ONE key) ---
# Free + fastest: https://console.groq.com/keys
GROQ_API_KEY=
# Free alternative: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- PostgreSQL ---
# Leave these unset to use the database from `docker compose up -d db` (localhost:5433, proofpath/proofpath).
# Set them to use your own server, or a hosted one such as Neon (postgres://user:pass@host/db?sslmode=require).
# DATABASE_URL=jdbc:postgresql://localhost:5432/proofpath
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=

# --- GitHub (optional) ---
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_PUBLIC_BASE_URL=

# --- Sign in with GitHub (optional) ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL for local development: http://localhost:5173/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# APP_BASE_URL=http://localhost:5173
# SESSION_SECRET=

# --- Account emails (optional): confirm-your-email and password-reset links ---
# Free key from https://resend.com. Without it, email accounts start verified and password reset is off.
# RESEND_API_KEY=
# EMAIL_FROM=ProofPath <onboarding@resend.dev>
